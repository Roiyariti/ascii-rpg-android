{
  "version": "2.0.0",
  "tasks": [
    { "label": "Rust: compilar Linux", "type": "process", "command": "cargo", "args": ["build", "--workspace", "--locked"], "problemMatcher": ["$rustc"], "group": { "kind": "build", "isDefault": true } },
    { "label": "Rust: pruebas", "type": "process", "command": "cargo", "args": ["test", "--workspace", "--locked"], "problemMatcher": ["$rustc"], "group": { "kind": "test", "isDefault": true } },
    { "label": "Rust: formato", "type": "process", "command": "cargo", "args": ["fmt", "--all"], "problemMatcher": [] },
    { "label": "Rust: clippy", "type": "process", "command": "cargo", "args": ["clippy", "--workspace", "--all-targets", "--locked", "--", "-D", "warnings"], "problemMatcher": ["$rustc"] },
    { "label": "Demo: ejecutar Linux", "type": "process", "command": "cargo", "args": ["run", "--locked", "-p", "glyph-demo", "--bin", "glyph-demo"], "problemMatcher": ["$rustc"] },
    { "label": "Demo: prueba GPU", "type": "process", "command": "cargo", "args": ["run", "--locked", "-p", "ascii-renderer", "--example", "gpu-smoke"], "problemMatcher": ["$rustc"] },
    { "label": "Android: biblioteca ARM64", "type": "process", "command": "sh", "args": ["scripts/build-android.sh", "--library-only"], "problemMatcher": ["$rustc"] },
    { "label": "Android: APK debug", "type": "process", "command": "sh", "args": ["scripts/build-android.sh"], "problemMatcher": ["$rustc"] }
  ]
}
